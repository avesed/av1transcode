-static enum AVPixelFormat get_format(HEVCContext *s, const HEVCSPS *sps)
+/* Whether the hwaccel that is set up can decode pictures of a newly activated
+ * SPS as it is, so get_format() need not tear it down and build it again.
+ *
+ * ff_get_format() starts with ff_hwaccel_uninit() (decode.c:1256), which for
+ * VA-API destroys the decode context and drops the frames context
+ * (vaapi_decode.c:738-760, decode.c:1226). hevc runs it at every SPS
+ * activation, including one that changes only HRD or transform-depth fields,
+ * as Blu-ray remuxes do at a programme boundary. The filter thread can still
+ * be syncing frames of that context while the decoder thread destroys it, and
+ * iHD serialises neither side against the other: vaSyncSurface's status query
+ * calls into the codec pipeline that vaDestroyContext is tearing down. That
+ * segfaulted iHD in production. A NULL check on the surface's decode context
+ * in iHD would not fix it, because both pointers are still set when they are
+ * read; not destroying the context does.
+ *
+ * The VA-API hwaccel takes from the SPS only the VAProfile (avctx->profile),
+ * the coded size and the software format (vaapi_decode.c:478-650, 692-736),
+ * and sizes no surface pool from the DPB (vaapi_decode.c:628-629). Everything
+ * else it reads from the current SPS and PPS for each picture
+ * (vaapi_hevc.c:124-345). So it is kept when those are unchanged, its frames
+ * context still has the new coded size, and the VPS - the layers, alpha and
+ * views get_format() exports - is the same object. Not kept: RExt and SCC,
+ * whose VAProfile comes from the SPS constraint flags (vaapi_hevc.c:597-657),
+ * and every hwaccel other than VA-API, which is all this was checked for. */
+static int hwaccel_keeps_for_sps(const HEVCContext *s, const HEVCSPS *old_sps,
+                                 const HEVCSPS *sps)
+{
+    const AVCodecContext *avctx = s->avctx;
+    const AVHWFramesContext *frames;
+    int profile = sps->ptl.general_ptl.profile_idc;
+
+    if (!old_sps || !avctx->hwaccel || !avctx->internal->hwaccel_priv_data ||
+        !avctx->hw_frames_ctx || avctx->hwaccel->pix_fmt != AV_PIX_FMT_VAAPI)
+        return 0;
+
+    frames = (const AVHWFramesContext *)avctx->hw_frames_ctx->data;
+
+    return sps->vps     == old_sps->vps                         &&
+           sps->pix_fmt == old_sps->pix_fmt                     &&
+           sps->pix_fmt == avctx->sw_pix_fmt                    &&
+           sps->width   == old_sps->width                       &&
+           sps->height  == old_sps->height                      &&
+           profile      == old_sps->ptl.general_ptl.profile_idc &&
+           (profile == AV_PROFILE_HEVC_MAIN    ||
+            profile == AV_PROFILE_HEVC_MAIN_10 ||
+            profile == AV_PROFILE_HEVC_MAIN_STILL_PICTURE)      &&
+           frames->format == AV_PIX_FMT_VAAPI                   &&
+           frames->width  == sps->width                         &&
+           frames->height == sps->height;
+}
+
+static enum AVPixelFormat get_format(HEVCContext *s, const HEVCSPS *sps,
+                                     int keep_hwaccel)
 {
 #define HWACCEL_MAX (CONFIG_HEVC_DXVA2_HWACCEL + \
                      CONFIG_HEVC_D3D11VA_HWACCEL * 2 + \
@@ -709,9 +761,27 @@
     if (ret < 0)
         return ret;
 
-    ret = ff_get_format(s->avctx, pix_fmts);
-    if (ret < 0)
-        return ret;
+    if (keep_hwaccel) {
+        /* hwaccel_keeps_for_sps(): the hwaccel keeps its VA config, decode
+         * context and frames context, so no frames context is replaced under
+         * frames still in use, and none reaches the caller as a new one. The
+         * user's get_format() is not asked again: the list it would get is the
+         * same (same pix_fmt and VPS), and export_stream_params() has just set
+         * pix_fmt to the software format, which is put back here. At INFO:
+         * reads run at -loglevel info, and one line per kept change is what
+         * shows the path was taken. */
+        av_log(s->avctx, AV_LOG_INFO, "Keeping hwaccel %s for a new SPS: "
+               "coded %dx%d, %s, profile %d unchanged (packet pts %"PRId64")\n",
+               s->avctx->hwaccel->name, sps->width, sps->height,
+               av_get_pix_fmt_name(sps->pix_fmt),
+               sps->ptl.general_ptl.profile_idc,
