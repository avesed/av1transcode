# Everything in config.yaml can be overridden with env vars:
#   AV1TC_<SECTION>_<KEY>   e.g. AV1TC_WORKERS_CONCURRENCY=2
#   AV1TC_TRANSCODE_VIDEO_CRF=26

# --- concurrency ---
AV1TC_WORKERS_CONCURRENCY=1
AV1TC_WORKERS_AV1AN_WORKERS=0

# --- Dolby Vision ---
# P5 conversion method: libplacebo (accurate, needs Vulkan) | zscale (approx)
AV1TC_TRANSCODE_DOVI_P5_METHOD=libplacebo
AV1TC_TRANSCODE_DOVI_SAVE_RPU=true

# --- watcher ---
AV1TC_WATCHER_ENABLED=true
AV1TC_WATCHER_STABLE_SECONDS=30

# --- web ---
AV1TC_WEB_PORT=8080
AV1TC_WEB_API_KEY=