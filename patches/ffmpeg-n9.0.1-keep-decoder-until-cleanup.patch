--- a/fftools/ffmpeg_dec.c
+++ b/fftools/ffmpeg_dec.c
@@ -1016,7 +1016,13 @@
 
 finish:
     dec_thread_uninit(&dt);
-    avcodec_free_context(&dp->dec_ctx);
+    /* The codec context - and with it a hwaccel's decode context - is freed
+     * by dec_free() at cleanup, after the filtergraphs. Freeing it here, as
